# N_160. Сайт больше не обращается к Supabase напрямую.
# Укажите адрес GIP API, который доступен пользователям без VPN.
# Если сайт и API находятся на одном сервере и проксируются как /api, оставьте /api.
VITE_GIP_API_BASE_URL=/api

# Необязательно. Заполняется только если в GIP API включен GIP_API_KEY.
VITE_GIP_API_KEY=

VITE_SITE_SECTIONS_TABLE=opr_site_sections
VITE_SITE_FILES_TABLE=opr_site_section_files
VITE_SITE_INCOMING_TABLE=opr_site_incoming_files
VITE_SITE_FILES_BUCKET=

VITE_YANDEX_SERVICE_ROOT=/Программные файлы/OPR-site
VITE_YANDEX_DISK_ROOT=/Для Технического заказчика
VITE_YANDEX_GIP_ROOT=/Папка ГИПа
VITE_YANDEX_INCOMING_FOLDER=_Входящие_с_сайта
VITE_MAX_INCOMING_UPLOAD_BYTES=157286400
