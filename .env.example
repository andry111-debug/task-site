VITE_GIP_API_BASE_URL=/api
# This variable is used only on Vercel server side by api/[...path].js
GIP_API_UPSTREAM=http://IP_SERVER:3100/api

# Norm-control internal exchange folders.
# Result files uploaded by the norm controller are stored in:
# /Внутренняя технологии/Нормаконтролер/<building>/<section>/ответ/
VITE_NORM_CONTROL_INTERNAL_ROOT=/Внутренняя технологии/Нормаконтролер
VITE_NORM_CONTROL_INTERNAL_FILES_FOLDER=файлы
VITE_NORM_CONTROL_INTERNAL_ANSWER_FOLDER=ответ
