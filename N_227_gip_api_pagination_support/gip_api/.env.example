# GIP API, N_159
PORT=3100
HOST=0.0.0.0

# Необязательно. Если заполнить, сайт должен передавать такой же VITE_GIP_API_KEY.
GIP_API_KEY=

# Supabase. Лучше использовать SERVICE_ROLE_KEY, потому что запросы теперь идут с сервера.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Если service role key пока нет, можно временно указать anon key:
SUPABASE_ANON_KEY=

# Яндекс.Диск OAuth token
YANDEX_ACCESS_TOKEN=YOUR_YANDEX_DISK_OAUTH_TOKEN

# Разрешенные таблицы для проксирования из сайта
ALLOWED_TABLES=employees,ppt_schedule,opr_site_sections,opr_site_section_files,opr_site_incoming_files,opr_site_action_history

# CORS. Для проверки можно оставить *, потом лучше указать домен сайта.
CORS_ORIGIN=*
